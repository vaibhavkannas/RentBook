# Copy to .env.local for local runs. Never commit .env.local.
# On Vercel, set the same names under Project Settings > Environment Variables.

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`. At least 32 characters: the app
# refuses to start a session with a shorter one. It also signs the retry token and the "just wrote" cookie.
AUTH_SECRET=
# Google OAuth client (Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The public address of the app, for example https://rentbook.example.com (no path). Optional while you run it on
# your own computer. In production set it: Auth.js then builds the Google sign-in return address from it instead of
# from the request's Host header. Leave it unset for Vercel Preview deployments, which each have their own address.
# Leave the line out rather than empty: an empty AUTH_URL makes Auth.js stop trusting the host.
# AUTH_URL=https://rentbook.example.com
# The "sign everyone out" switch: a date and time such as 2026-10-16T10:00:00Z. Every session signed in before it
# is refused and has to sign in again. Leave it out normally. To use it, set it to the current time (UTC) and
# redeploy. A value that is not a date and time signs everyone out too.
# SESSION_NOT_BEFORE=2026-10-16T10:00:00Z
# Google accounts allowed to sign in, separated by commas. The first one is the owner
# (the only person who can change Portion settings).
ALLOWED_EMAILS=owner@example.com

# Service account key JSON, pasted as one line
GOOGLE_SERVICE_ACCOUNT_JSON=
# The ID part of https://docs.google.com/spreadsheets/d/<ID>/edit
SHEET_ID=
# Name of the tab that holds the month rows
SCHEDULE_TAB=Schedule
# Exact header text of the monthly total column
TOTAL_HEADER=
# Emergency switch for the Content-Security-Policy. Set to 1 and redeploy: the browser then only reports what the
# policy would have blocked, and blocks nothing. Use it only if the policy is breaking a page you need, and take it
# out again once that is fixed. Leave it out normally.
# CSP_REPORT_ONLY=1
