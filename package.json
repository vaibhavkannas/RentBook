{
  "name": "rentbook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "tsx scripts/e2e/run.ts",
    "recon": "tsx --conditions=react-server --env-file=.env.local scripts/recon.ts",
    "verify:testcopy": "tsx --conditions=react-server --env-file=.env.local scripts/verify-testcopy.ts"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.1.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
